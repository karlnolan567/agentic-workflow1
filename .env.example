# Required: Gemini API key (GEMINI_API_KEY preferred; GOOGLE_API_KEY also supported)
GEMINI_API_KEY=

# Optional: model for both Triage Hub and Persona (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: use offline demo responses (no Gemini calls) — useful when quota is exceeded
USE_DEMO_LLM=false
